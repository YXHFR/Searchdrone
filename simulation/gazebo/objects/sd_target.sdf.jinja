{#
  One object of a scenario (sd_sim.targets.Target) as a world-level model: static, with the
  simulator's label system so the bounding-box camera can name it, its base on the ground
  at the pose the world renderer gives. Rendered by sd_sim.targets; x is the long side.
#}
<model name="{{ t.name }}">
  <static>true</static>
  <pose>{{ pose }}</pose>
  <link name="link">
    <visual name="body">
      <pose>0 0 {{ (t.size_m[2] / 2) | round(4) }} 0 0 0</pose>
      <geometry>
        <box>
          <size>{{ t.size_m[0] }} {{ t.size_m[1] }} {{ t.size_m[2] }}</size>
        </box>
      </geometry>
      <material>
        <ambient>{{ t.rgb[0] }} {{ t.rgb[1] }} {{ t.rgb[2] }} 1</ambient>
        <diffuse>{{ t.rgb[0] }} {{ t.rgb[1] }} {{ t.rgb[2] }} 1</diffuse>
      </material>
    </visual>
{% if t.cls == "car" %}
    <visual name="cabin">
      <pose>-0.3 0 {{ (t.size_m[2] + 0.25) | round(3) }} 0 0 0</pose>
      <geometry>
        <box>
          <size>{{ (t.size_m[0] * 0.5) | round(3) }} {{ (t.size_m[1] * 0.9) | round(3) }} 0.5</size>
        </box>
      </geometry>
      <material>
        <ambient>0.15 0.18 0.22 1</ambient>
        <diffuse>0.15 0.18 0.22 1</diffuse>
      </material>
    </visual>
{% elif t.cls == "building" %}
    <visual name="roof">
      <pose>0 0 {{ (t.size_m[2] + 0.15) | round(3) }} 0 0 0</pose>
      <geometry>
        <box>
          <size>{{ (t.size_m[0] + 0.6) | round(3) }} {{ (t.size_m[1] + 0.6) | round(3) }} 0.3</size>
        </box>
      </geometry>
      <material>
        <ambient>{{ roof[0] }} {{ roof[1] }} {{ roof[2] }} 1</ambient>
        <diffuse>{{ roof[0] }} {{ roof[1] }} {{ roof[2] }} 1</diffuse>
      </material>
    </visual>
{% endif %}
  </link>
  <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
    <label>{{ t.gz_label }}</label>
  </plugin>
</model>
