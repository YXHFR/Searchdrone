<?xml version="1.0"?>
<!-- sd_quad14: Searchdrone's 14-inch quad for the simulator. sd_sim.world renders a copy
     per simulator instance (sd_quad14_i<N>) next to the rendered model.sdf. -->
<model>
  <name>sd_quad14</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Searchdrone contributors</name>
  </author>
  <description>
    Quad X, 2.3 kg, 0.58 m motor diagonal, 14-inch propellers, fixed nadir camera
    (640x480, 15 frames/s, 80 degrees) streamed as H.264 over UDP to 127.0.0.1.
  </description>
</model>
