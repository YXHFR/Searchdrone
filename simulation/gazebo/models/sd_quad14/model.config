<?xml version="1.0"?>
<!--
  sd_quad14: Searchdrone's 14-inch quad for the simulator, with a camera pointing straight
  down. Derived from ArduPilot's iris_with_standoffs and iris_with_gimbal models in
  ardupilot_gazebo (LGPL-3.0); see REUSE.toml.
-->
<model>
  <name>sd_quad14</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Searchdrone contributors</name>
  </author>
  <author>
    <name>ardupilot_gazebo authors (iris models: Fadri Furrer, Michael Burri, Mina Kamel, Janosch Nikolic, Markus Achtelik, Rhys Mainwaring)</name>
  </author>
  <description>
    Quad X, 2.3 kg, 0.58 m motor diagonal, 14-inch propellers, fixed nadir camera
    (640x480, 15 frames/s, 80 degrees) streamed as H.264 over UDP to 127.0.0.1.
  </description>
  <depend>
    <model>
      <uri>model://iris_with_standoffs</uri>
      <version>2.0</version>
    </model>
  </depend>
</model>
