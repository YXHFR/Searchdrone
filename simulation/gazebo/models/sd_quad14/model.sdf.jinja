<?xml version="1.0"?>
<!--
  sd_quad14: Searchdrone's 14-inch quad X for Gazebo Harmonic, driven by ArduPilot SITL
  through the ArduPilot plugin. Rendered per simulator instance by sd_sim.world; do not
  edit the rendered copy under build/. Masses, rotor speed and lift come from
  hardware/drone.yaml and the constants in sd_sim/world.py.

  Frames: x forward, y left, z up. Rotors 0-3 follow ArduPilot's quad X motor order.
-->
<sdf version="1.9">
  <model name="{{ name }}">
    <!-- Body origin above the ground so the landing legs just touch it. -->
    <pose>0 0 0.2 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>{{ base_mass }}</mass>
        <inertia>
          <ixx>{{ inertia[0] }}</ixx>
          <iyy>{{ inertia[1] }}</iyy>
          <izz>{{ inertia[2] }}</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body">
        <geometry>
          <box>
            <size>0.24 0.18 0.08</size>
          </box>
        </geometry>
      </collision>
      <visual name="body">
        <geometry>
          <box>
            <size>0.24 0.18 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
{% for rotor in rotors %}
      <visual name="arm_{{ loop.index0 }}">
        <pose>{{ (rotor.x / 2) | round(4) }} {{ (rotor.y / 2) | round(4) }} 0.02 0 0 {{ rotor.yaw }}</pose>
        <geometry>
          <box>
            <size>0.29 0.03 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
{% endfor %}
{% for sx, sy in [(1, 1), (1, -1), (-1, 1), (-1, -1)] %}
      <!-- Landing leg {{ loop.index0 }}: a high-friction rod so the vehicle does not slide. -->
      <collision name="leg_{{ loop.index0 }}">
        <pose>{{ 0.14 * sx }} {{ 0.14 * sy }} -0.11 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1000</mu>
              <mu2>1000</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="leg_{{ loop.index0 }}">
        <pose>{{ 0.14 * sx }} {{ 0.14 * sy }} -0.11 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
{% endfor %}
    </link>

    <!-- The flight controller's IMU. ArduPilot expects it upside down (z down). -->
    <link name="imu_link">
      <inertial>
        <mass>{{ imu_mass }}</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <iyy>1e-05</iyy>
          <izz>1e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

{% for rotor in rotors %}
    <!-- Rotor {{ loop.index0 }}: {{ "counter-clockwise" if rotor.ccw else "clockwise" }} seen from above. -->
    <link name="rotor_{{ loop.index0 }}">
      <pose>{{ rotor.x | round(4) }} {{ rotor.y | round(4) }} 0.04 0 0 0</pose>
      <inertial>
        <mass>{{ rotor_mass }}</mass>
        <inertia>
          <ixx>{{ rotor_ixx }}</ixx>
          <iyy>{{ rotor_ixx }}</iyy>
          <izz>{{ rotor_izz }}</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="disc">
        <geometry>
          <cylinder>
            <radius>{{ prop_radius }}</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>{{ "0.1 0.3 0.8 0.6" if rotor.ccw else "0.8 0.4 0.1 0.6" }}</ambient>
          <diffuse>{{ "0.1 0.3 0.8 0.6" if rotor.ccw else "0.8 0.4 0.1 0.6" }}</diffuse>
        </material>
        <transparency>0.4</transparency>
      </visual>
    </link>
    <joint name="rotor_{{ loop.index0 }}_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_{{ loop.index0 }}</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>
{% for blade in [1, -1] %}
    <!-- Lift of rotor {{ loop.index0 }}, {{ "first" if blade == 1 else "second" }} blade half. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>rotor_{{ loop.index0 }}</link_name>
      <cp>{{ blade_cp * blade }} 0 0</cp>
      <forward>0 {{ rotor.sign * blade }} 0</forward>
      <upward>0 0 1</upward>
      <area>{{ blade_area }}</area>
      <air_density>{{ air_density }}</air_density>
      <a0>{{ blade_a0 }}</a0>
      <cla>{{ cla }}</cla>
      <cda>0.1</cda>
      <alpha_stall>1.4</alpha_stall>
      <cla_stall>-0.025</cla_stall>
    </plugin>
{% endfor %}
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>rotor_{{ loop.index0 }}_joint</joint_name>
    </plugin>

{% endfor %}
    <!-- Nadir camera, fixed to the body (no gimbal). A Gazebo camera looks along its x
         axis; +90 degrees pitch points it straight down. -->
    <link name="camera_link">
      <pose>0.06 0 -0.06 0 0 0</pose>
      <inertial>
        <mass>{{ camera_mass }}</mass>
        <inertia>
          <ixx>2e-05</ixx>
          <iyy>2e-05</iyy>
          <izz>2e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry>
          <box>
            <size>0.04 0.04 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <sensor name="camera" type="camera">
        <pose degrees="true">0 0 0 0 90 0</pose>
        <camera>
          <horizontal_fov>{{ camera.hfov_rad }}</horizontal_fov>
          <image>
            <width>{{ camera.width }}</width>
            <height>{{ camera.height }}</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>5000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>{{ camera.fps }}</update_rate>
        <visualize>0</visualize>
        <!-- H.264 over RTP/UDP to the simulated radio link, loopback only. -->
        <plugin name="GstCameraPlugin" filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>{{ video_port }}</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <!-- The bridge to ArduPilot SITL (JSON over UDP, lock-step with the simulator clock). -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>{{ fdm_port_in }}</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <!-- Model x forward / z up and world ENU, turned into ArduPilot's x forward / z down
           and NED. -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_link::imu_sensor</imuName>
{% for rotor in rotors %}
      <!-- Motor {{ loop.index }}: PWM 1100-1900 maps to 0..{{ multiplier }} rad/s. -->
      <control channel="{{ loop.index0 }}">
        <jointName>rotor_{{ loop.index0 }}_joint</jointName>
        <type>VELOCITY</type>
        <useForce>1</useForce>
        <multiplier>{{ rotor.sign * multiplier }}</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <p_gain>0.2</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
{% endfor %}
    </plugin>
  </model>
</sdf>
