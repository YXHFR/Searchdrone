<?xml version="1.0"?>
<!--
  sd_quad14 for Gazebo Harmonic. Rendered per simulator instance by sd_sim.world; do not
  edit the rendered copy under build/. Derived from ArduPilot's iris_with_standoffs and
  iris_with_gimbal (ardupilot_gazebo, LGPL-3.0). Changed: mass and inertia, rotor positions
  for a 0.58 m X frame, rotor speed and blade area for 14-inch propellers, ports per
  instance, and a fixed nadir camera instead of the gimbal.
-->
<sdf version="1.9">
  <model name="{{ name }}">
    <pose>0 0 0.195 0 0 0</pose>

    <link name="base_link">
      <velocity_decay>
        <linear>0.0</linear>
        <angular>0.0</angular>
      </velocity_decay>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>{{ base_mass }}</mass>
        <inertia>
          <ixx>{{ inertia[0] }}</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>{{ inertia[1] }}</iyy>
          <iyz>0</iyz>
          <izz>{{ inertia[2] }}</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.30 0.30 0.10</size>
          </box>
        </geometry>
      </collision>
{% for leg in [(1, 1), (1, -1), (-1, 1), (-1, -1)] %}
      <collision name="leg_{{ loop.index0 }}_collision">
        <pose>{{ 0.15 * leg[0] }} {{ 0.15 * leg[1] }} -0.11 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.17</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="leg_{{ loop.index0 }}_visual">
        <pose>{{ 0.15 * leg[0] }} {{ 0.15 * leg[1] }} -0.11 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.17</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1</ambient>
          <diffuse>0.1 0.1 0.1</diffuse>
        </material>
      </visual>
{% endfor %}
      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.22 0.16 0.07</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05</ambient>
          <diffuse>0.05 0.05 0.05</diffuse>
        </material>
      </visual>
{% for rotor in rotors %}
      <visual name="arm_{{ loop.index0 }}_visual">
        <pose>{{ rotor.x / 2 }} {{ rotor.y / 2 }} 0.01 0 0 {{ rotor.yaw }}</pose>
        <geometry>
          <box>
            <size>0.30 0.025 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15</ambient>
          <diffuse>0.15 0.15 0.15</diffuse>
        </material>
      </visual>
{% endfor %}
    </link>

    <link name="imu_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>{{ imu_mass }}</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>
    <joint name="imu_joint" type="revolute">
      <child>imu_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>

{% for rotor in rotors %}
    <link name="rotor_{{ loop.index0 }}">
      <pose>{{ rotor.x | round(4) }} {{ rotor.y | round(4) }} 0.023 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>{{ rotor_mass }}</mass>
        <inertia>
          <ixx>{{ rotor_ixx }}</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>{{ rotor_ixx }}</iyy>
          <iyz>0</iyz>
          <izz>{{ rotor_izz }}</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>{{ prop_radius }}</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <scale>1.48 1.48 1</scale>
            <uri>model://iris_with_standoffs/meshes/iris_prop_{{ rotor.spin }}.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>{{ "0 0 1" if rotor.spin == "ccw" else "0.1 0.1 0.1" }}</ambient>
          <diffuse>{{ "0 0 1" if rotor.spin == "ccw" else "0.1 0.1 0.1" }}</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_{{ loop.index0 }}_joint" type="revolute">
      <child>rotor_{{ loop.index0 }}</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>

{% endfor %}
    <link name="camera_link">
      <pose>0.05 0 -0.06 0 0 0</pose>
      <inertial>
        <mass>{{ camera_mass }}</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.04 0.04 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3</ambient>
          <diffuse>0.3 0.3 0.3</diffuse>
        </material>
      </visual>
      <!-- Fixed nadir camera: a camera looks along its x axis; pitch +90 deg points it down. -->
      <sensor name="camera" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose degrees="true">0 0 0 0 90 0</pose>
        <camera>
          <horizontal_fov>{{ camera.hfov_rad }}</horizontal_fov>
          <image>
            <width>{{ camera.width }}</width>
            <height>{{ camera.height }}</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>{{ camera.fps }}</update_rate>
        <visualize>0</visualize>
        <plugin name="GstCameraPlugin" filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>{{ video_port }}</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- plugins -->
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>
{% for rotor in rotors %}
{% set i = loop.index0 %}
{% for blade in [1, -1] %}
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>{{ blade_area }}</area>
      <air_density>1.2041</air_density>
      <cp>{{ 0.084 * blade }} 0 0</cp>
      <forward>0 {{ rotor.fwd * blade }} 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_{{ i }}</link_name>
    </plugin>
{% endfor %}
{% endfor %}
{% for rotor in rotors %}
    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>rotor_{{ loop.index0 }}_joint</joint_name>
    </plugin>
{% endfor %}

    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>{{ fdm_port_in }}</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <!-- ArduPilot needs x forward, z down. -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_link::imu_sensor</imuName>
      <!-- Command [0, 1] times the maximum rotor speed in rad/s. -->
{% for rotor in rotors %}
      <control channel="{{ loop.index0 }}">
        <jointName>rotor_{{ loop.index0 }}_joint</jointName>
        <useForce>1</useForce>
        <multiplier>{{ rotor.sign * multiplier }}</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
{% endfor %}
    </plugin>
  </model>
</sdf>
