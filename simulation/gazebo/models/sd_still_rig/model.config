<?xml version="1.0"?>
<!-- sd_still_rig: a free-floating stills camera for rendering test pictures.
     sd_sim.render_stills renders a copy per simulator instance (sd_still_rig_i<N>). -->
<model>
  <name>sd_still_rig</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Searchdrone contributors</name>
  </author>
  <description>
    A static model with the vehicle's stills camera and a bounding-box camera with the
    same picture, moved from pose to pose to render detector test pictures.
  </description>
</model>
