<?xml version="1.0"?>
<!--
  sd_still_rig: the stills camera without a vehicle, for rendering detector test pictures.
  Like on sd_quad14 the cameras look along their x axis, pitched +90 degrees: straight
  down, the top of the picture towards the model's front. Rendered by sd_sim.render_stills.
-->
<sdf version="1.9">
  <model name="{{ name }}">
    <static>true</static>
    <link name="link">
{% for sensor, kind in [("stills", "camera"), ("boxes", "boundingbox_camera")] %}
      <sensor name="{{ sensor }}" type="{{ kind }}">
        <pose degrees="true">0 0 0 0 90 0</pose>
        <topic>{{ topic_prefix }}/{{ sensor }}</topic>
        <camera>
          <horizontal_fov>{{ hfov_rad }}</horizontal_fov>
          <image>
            <width>{{ width }}</width>
            <height>{{ height }}</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>2000</far>
          </clip>
{% if kind == "boundingbox_camera" %}
          <box_type>2d</box_type>
{% endif %}
        </camera>
        <always_on>1</always_on>
        <update_rate>{{ rate_hz }}</update_rate>
        <visualize>0</visualize>
      </sensor>
{% endfor %}
    </link>
  </model>
</sdf>
