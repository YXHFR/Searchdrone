<?xml version="1.0"?>
<!-- sd_targets: the search targets and labelled objects of a scenario. sd_sim.targets
     renders a copy per simulator instance (sd_targets_i<N>) next to the rendered model.sdf. -->
<model>
  <name>sd_targets</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Searchdrone contributors</name>
  </author>
  <description>
    Red blocks (the targets), decoys and context objects (car, building, road), each with
    the label of its class for the bounding-box camera. Simple boxes, no textures.
  </description>
</model>
