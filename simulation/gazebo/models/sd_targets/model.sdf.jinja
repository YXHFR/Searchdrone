<?xml version="1.0"?>
<!--
  One object of a scenario ({{ t.cls }}, {{ t.role }}) with the simulator's label system so
  the bounding-box camera can name it. Every object is a model of its own: the camera
  gives one box per top-level model. Rendered by sd_sim.targets (seeded); do not edit the
  rendered copy under build/. x is east and y is north of the landing pad.
-->
<sdf version="1.9">
  <model name="{{ name }}">
    <static>true</static>
    <pose>{{ t.east_m }} {{ t.north_m }} {{ t.z }} 0 0 {{ t.yaw_rad }}</pose>
    <link name="link">
      <visual name="body">
        <geometry>
          <box>
            <size>{{ t.size_m[0] }} {{ t.size_m[1] }} {{ t.size_m[2] }}</size>
          </box>
        </geometry>
        <material>
          <ambient>{{ t.rgb[0] }} {{ t.rgb[1] }} {{ t.rgb[2] }} 1</ambient>
          <diffuse>{{ t.rgb[0] }} {{ t.rgb[1] }} {{ t.rgb[2] }} 1</diffuse>
        </material>
      </visual>
{% if t.cls == "car" %}
      <visual name="cabin">
        <pose>-0.3 0 {{ (t.size_m[2] / 2 + 0.25) | round(3) }} 0 0 0</pose>
        <geometry>
          <box>
            <size>{{ (t.size_m[0] * 0.5) | round(3) }} {{ (t.size_m[1] * 0.9) | round(3) }} 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.18 0.22 1</ambient>
          <diffuse>0.15 0.18 0.22 1</diffuse>
        </material>
      </visual>
{% elif t.cls == "building" %}
      <visual name="roof">
        <pose>0 0 {{ (t.size_m[2] / 2 + 0.15) | round(3) }} 0 0 0</pose>
        <geometry>
          <box>
            <size>{{ (t.size_m[0] + 0.6) | round(3) }} {{ (t.size_m[1] + 0.6) | round(3) }} 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>{{ roof[0] }} {{ roof[1] }} {{ roof[2] }} 1</ambient>
          <diffuse>{{ roof[0] }} {{ roof[1] }} {{ roof[2] }} 1</diffuse>
        </material>
      </visual>
{% endif %}
    </link>
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
      <label>{{ t.gz_label }}</label>
    </plugin>
  </model>
</sdf>
