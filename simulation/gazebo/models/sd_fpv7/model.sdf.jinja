<?xml version="1.0"?>
<!--
  sd_fpv7: the owner's 7-inch quad X for Gazebo Harmonic, driven by ArduPilot SITL through
  the ArduPilot plugin. Rendered per simulator instance by sd_sim.world; do not edit the
  rendered copy under build/. Mass, centre of gravity, inertia, rotor positions and the
  meshes come from the CAD model (cad.json and meshes/ next to this file, generated by
  tools/sim_model_from_cad.py); rotor speed and lift from sd_sim/fpv7.py.

  Frames: the CAD axes, x forward, y left, z up, origin at the frame centre under the
  bottom plate. Rotors 0-3 follow ArduPilot's quad X motor order.
-->
<sdf version="1.9">
  <model name="{{ name }}">
    <!-- Body origin above the ground so the landing legs just touch it. -->
    <pose>0 0 {{ stand_m }} 0 0 0</pose>

    <link name="base_link">
      <!-- The CAD mass minus the IMU, camera and propeller links, at its own centre of
           mass: all links together have the CAD model's mass, centre and inertia. -->
      <inertial>
        <pose>{{ base_com | join(" ") }} 0 0 0</pose>
        <mass>{{ base_mass }}</mass>
        <inertia>
          <ixx>{{ base_inertia.ixx }}</ixx>
          <iyy>{{ base_inertia.iyy }}</iyy>
          <izz>{{ base_inertia.izz }}</izz>
          <ixy>{{ base_inertia.ixy }}</ixy>
          <ixz>{{ base_inertia.ixz }}</ixz>
          <iyz>{{ base_inertia.iyz }}</iyz>
        </inertia>
      </inertial>
      <collision name="body">
        <pose>{{ body_box.pose | join(" ") }} 0 0 0</pose>
        <geometry>
          <box>
            <size>{{ body_box.size | join(" ") }}</size>
          </box>
        </geometry>
      </collision>
{% for uri in meshes %}
      <visual name="cad_{{ loop.index0 }}">
        <geometry>
          <mesh>
            <uri>{{ uri }}</uri>
            <scale>{{ mesh_scale }} {{ mesh_scale }} {{ mesh_scale }}</scale>
          </mesh>
        </geometry>
      </visual>
{% endfor %}
{% for leg in legs %}
      <!-- Landing leg {{ loop.index0 }}: high friction so the vehicle does not slide. -->
      <collision name="leg_{{ loop.index0 }}">
        <pose>{{ leg.pose | join(" ") }} 0 0 0</pose>
        <geometry>
          <box>
            <size>{{ leg.size | join(" ") }}</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1000</mu>
              <mu2>1000</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
{% endfor %}
    </link>

    <!-- The flight controller's IMU, where the CAD flight controller sits. ArduPilot
         expects it upside down (z down). -->
    <link name="imu_link">
      <pose>{{ imu_pose | join(" ") }} 0 0 0</pose>
      <inertial>
        <mass>{{ imu_mass }}</mass>
        <inertia>
          <ixx>{{ imu_inertia }}</ixx>
          <iyy>{{ imu_inertia }}</iyy>
          <izz>{{ imu_inertia }}</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

{% for rotor in rotors %}
    <!-- Rotor {{ loop.index0 }}: {{ "counter-clockwise" if rotor.ccw else "clockwise" }} seen from above. -->
    <link name="rotor_{{ loop.index0 }}">
      <pose>{{ rotor.x }} {{ rotor.y }} {{ rotor.z }} 0 0 0</pose>
      <inertial>
        <mass>{{ rotor_mass }}</mass>
        <inertia>
          <ixx>{{ rotor_ixx }}</ixx>
          <iyy>{{ rotor_ixx }}</iyy>
          <izz>{{ rotor_izz }}</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="blades">
        <geometry>
          <mesh>
            <uri>{{ prop_mesh[rotor.ccw] }}</uri>
            <scale>{{ mesh_scale }} {{ mesh_scale }} {{ mesh_scale }}</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="rotor_{{ loop.index0 }}_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_{{ loop.index0 }}</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>{{ rotor_damping }}</damping>
        </dynamics>
      </axis>
    </joint>
{% set index = loop.index0 %}{# inside the blade loop, loop is the blade loop #}
{% for blade in [1, -1] %}
    <!-- Lift of rotor {{ index }}, {{ "first" if blade == 1 else "second" }} blade half. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>rotor_{{ index }}</link_name>
      <cp>{{ blade_cp * blade }} 0 0</cp>
      <forward>0 {{ rotor.sign * blade }} 0</forward>
      <upward>0 0 1</upward>
      <area>{{ blade_area }}</area>
      <air_density>{{ air_density }}</air_density>
      <a0>{{ blade_a0 }}</a0>
      <cla>{{ cla }}</cla>
      <cda>0.1</cda>
      <alpha_stall>1.4</alpha_stall>
      <cla_stall>-0.025</cla_stall>
    </plugin>
{% endfor %}
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>rotor_{{ loop.index0 }}_joint</joint_name>
    </plugin>

{% endfor %}
    <!-- Nadir camera where the CAD camera sits, fixed to the body (no gimbal). A Gazebo
         camera looks along its x axis; +90 degrees pitch points it straight down. -->
    <link name="camera_link">
      <pose>{{ camera_pose | join(" ") }} 0 0 0</pose>
      <inertial>
        <mass>{{ camera_mass }}</mass>
        <inertia>
          <ixx>{{ camera_inertia }}</ixx>
          <iyy>{{ camera_inertia }}</iyy>
          <izz>{{ camera_inertia }}</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="camera" type="camera">
        <pose degrees="true">0 0 0 0 90 0</pose>
        <camera>
          <horizontal_fov>{{ camera.hfov_rad }}</horizontal_fov>
          <image>
            <width>{{ camera.width }}</width>
            <height>{{ camera.height }}</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>5000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>{{ camera.fps }}</update_rate>
        <visualize>0</visualize>
        <!-- H.264 over RTP/UDP to the simulated radio link, loopback only. -->
        <plugin name="GstCameraPlugin" filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>{{ video_port }}</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <!-- The bridge to ArduPilot SITL (JSON over UDP, lock-step with the simulator clock). -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>{{ fdm_port_in }}</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <!-- Model x forward / z up and world ENU, turned into ArduPilot's x forward / z down
           and NED. -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_link::imu_sensor</imuName>
{% for rotor in rotors %}
      <!-- Motor {{ loop.index }}: PWM 1100-1900 maps to 0..{{ multiplier }} rad/s. -->
      <control channel="{{ loop.index0 }}">
        <jointName>rotor_{{ loop.index0 }}_joint</jointName>
        <type>VELOCITY</type>
        <useForce>1</useForce>
        <multiplier>{{ rotor.sign * multiplier }}</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <p_gain>{{ rotor_p_gain }}</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
{% endfor %}
    </plugin>
  </model>
</sdf>
