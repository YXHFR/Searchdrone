<?xml version="1.0"?>
<!-- sd_fpv7: the owner's 7-inch quad for the simulator. sd_sim.world renders a copy per
     simulator instance (sd_fpv7_i<N>) next to the rendered model.sdf; the meshes stay
     here and are found as model://sd_fpv7/meshes/. -->
<model>
  <name>sd_fpv7</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Searchdrone contributors</name>
  </author>
  <description>
    Quad X on a GEPRC Mark4 7" frame (H, 193 x 223 mm between motor axes), EMAX ECO II
    2807 1300KV, HQ 7x4x3 propellers, 6S2P 10 000 mAh; mass, centre of gravity, inertia and
    looks from the CAD model hardware/cad/fpv7. Fixed nadir camera (640x480, 15 frames/s)
    streamed as H.264 over UDP to 127.0.0.1.
  </description>
</model>
