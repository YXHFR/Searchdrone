# Simulator-only parameters for the sd_quad14 model. Loaded after the safety parameters.
# Only SIM_* names and the names in tools/params_allowlist.toml may appear here; every
# safety-relevant value (battery, fence, failsafes) lives in searchdrone-safety.parm.
SIM_WIND_SPD 0           # no wind
SIM_WIND_DIR 0
MOT_THST_HOVER 0.42      # start value for the learned hover throttle
# Drag for the EKF's wind estimate and dead reckoning: SITL's own "Suggested EK3_DRAG_..."
# for this frame (test_drag_matches_sitl_suggestion keeps them within 10 %).
EK3_DRAG_BCOEF_X 34.756
EK3_DRAG_BCOEF_Y 34.756
EK3_DRAG_MCOEF 0.134
