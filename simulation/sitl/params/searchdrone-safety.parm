# Searchdrone safety parameters for ArduCopter Copter-4.7.1 (simulator profile).
# Loaded by the simulator after ArduPilot's defaults and before the model file.
# Nothing in Searchdrone writes these at run time; the onboard computer reads them back
# before every takeoff and refuses to fly if one differs. Format: NAME VALUE.

# --- who is the ground station --------------------------------------------------------
MAV_GCS_SYSID 250        # only sd-ground (250/190) keeps the GCS failsafe away

# --- lost ground station --------------------------------------------------------------
FS_GCS_ENABLE 3          # no ground station heartbeat -> SmartRTL, else RTL
FS_GCS_TIMEOUT 20        # seconds; equals FS_GCS_TIMEOUT_S in sd_safety.constants
FS_OPTIONS 24            # bit 3: keep landing if a landing is under way; bit 4: in LOITER (not an
                         # autopilot mode) the FC only reports the lost ground station and the
                         # onboard computer decides (link-loss rule, sd_gcs_loiter_cap.lua as backup)
FS_EKF_ACTION 1          # bad position estimate -> LAND (no pilot with sticks in sim)
FS_EKF_THRESH 0.8        # ArduPilot's default, written out so it is read back
FS_THR_ENABLE 0          # RC-loss failsafe off in the simulator profile; 4 with a real RC link

# --- battery (10000 mAh 6S2P Li-ion pack, see hardware/drone.yaml) ----------------------
BATT_MONITOR 4           # voltage and current
BATT_CAPACITY 10000      # mAh
BATT_LOW_MAH 1500        # 15 % of the capacity left -> low battery failsafe
BATT_CRT_MAH 700         # 7 % left -> critical battery failsafe
BATT_LOW_VOLT 0          # voltage limits off in the simulator (its pack is not 6S)
BATT_CRT_VOLT 0
BATT_FS_LOW_ACT 3        # low battery -> SmartRTL, else RTL
BATT_FS_CRT_ACT 1        # critical battery -> LAND

# --- geofence: always on, just outside the hard limits ---------------------------------
FENCE_ENABLE 1
FENCE_TYPE 7             # maximum height + circle around home + the mission polygon
FENCE_ACTION 3           # SmartRTL, else RTL, else LAND
FENCE_ALT_MAX 125        # m above home = 120 m limit + 5 m
FENCE_RADIUS 530         # m from home = 500 m limit + 30 m
FENCE_MARGIN 5           # m
AVOID_ENABLE 3           # ArduPilot's default; bit 0 brakes before the fence

# --- flying home ----------------------------------------------------------------------
RTL_ALT_M 30             # m above home on the way back (flat demo area)
RTL_SPEED_MS 8           # m/s for RTL and SmartRTL, so they never inherit WP_SPD
RTL_LOIT_TIME 0          # no wait above home before landing
SRTL_POINTS 300          # SmartRTL track buffer

# --- navigation -----------------------------------------------------------------------
WP_RADIUS_M 2            # m; a mission waypoint counts as reached within this radius
WP_SPD 5                 # m/s default in AUTO and GUIDED (not a cap; missions set speed)
LOIT_SPEED_MS 15         # m/s, the fastest LOITER may fly (= the 15 m/s limit)
GUID_TIMEOUT 3           # s; GUIDED velocity orders stop when they are not renewed

# --- arming and manual control ----------------------------------------------------------
ARMING_SKIPCHK 0         # every arming check on
ARMING_RUDDER 0          # sticks can never arm or disarm (also not via MANUAL_CONTROL yaw)
DISARM_DELAY 10          # s; the flight controller disarms by itself after landing
RC_OVERRIDE_TIME 1       # s; stick values older than this are dropped (vehicle holds)

# --- RC mode switch (simulator profile) --------------------------------------------------
# The same modes as ArduPilot's SITL defaults, so no default file decides them. The mapping
# for real flight is set together with the RC transmitter.
FLTMODE1 7               # CIRCLE
FLTMODE2 9               # LAND
FLTMODE3 6               # RTL
FLTMODE4 3               # AUTO
FLTMODE5 5               # LOITER
FLTMODE6 0               # STABILIZE

# --- GPS lost, jammed or spoofed ---------------------------------------------------------
# Without GPS the EKF keeps a position from speed and wind (EK3_DRAG_* in the model file)
# and the dead-reckoning failsafe flies home; after FS_DR_TIMEOUT the EKF failsafe lands.
FS_DR_ENABLE 2           # dead reckoning -> RTL
FS_DR_TIMEOUT 30         # s on dead reckoning before the EKF failsafe (FS_EKF_ACTION)
EK3_POS_I_GATE 500       # GPS readings beyond 5 standard deviations are rejected
EK3_GLITCH_RAD 25        # m; sd_safety.constants.SPOOF_JUMP_M must be larger
AHRS_GPS_MINSATS 6       # = GPS_WEAK_SATS in sd_safety.constants
# Position source sets. 1: GPS (normal). 2: no horizontal position or speed, set by the
# onboard computer's spoofing guard (MAV_CMD_SET_EKF_SOURCE_SET 2) or the pilot's switch.
# 3: the same as 2 (there is no third sensor). Only the pilot switches back to 1.
EK3_SRC1_POSXY 3         # GPS
EK3_SRC1_VELXY 3         # GPS
EK3_SRC1_POSZ 1          # barometer (the spoofing guard compares GPS height with it)
EK3_SRC1_VELZ 3          # GPS
EK3_SRC1_YAW 1           # compass
EK3_SRC2_POSXY 0         # none
EK3_SRC2_VELXY 0         # none
EK3_SRC2_POSZ 1          # barometer
EK3_SRC2_VELZ 0          # none
EK3_SRC2_YAW 1           # compass (ArduPilot's default 0 would drop the heading)
EK3_SRC3_POSXY 0
EK3_SRC3_VELXY 0
EK3_SRC3_POSZ 1
EK3_SRC3_VELZ 0
EK3_SRC3_YAW 1
EK3_SRC_OPTIONS 0        # bit 0 off: set 2 must not keep fusing GPS speed
RC8_OPTION 0             # no source switch in the simulator; 90 with a real RC link

# --- scripting ------------------------------------------------------------------------
SCR_ENABLE 1             # one Lua script: sd_gcs_loiter_cap.lua (simulation/sitl/scripts)
