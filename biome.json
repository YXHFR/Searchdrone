{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/generated",
      "!software/ground/tests/contract/snapshots",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-test"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["software/panel/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noAlert": "error"
          },
          "security": {
            "noDangerouslySetInnerHtml": "error"
          }
        }
      }
    }
  ]
}
