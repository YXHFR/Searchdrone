# Names of local secrets and settings. Copy is created by `just setup-config`.
# Never put real values in this file. `just setup-config` writes `.env`
# (gitignored) and fills every empty value marked "generated" with a random value.

# generated: owner password for the local Postgres container
SD_GROUND__DB_PASSWORD=
# generated: application password for the local Postgres container
SD_GROUND__DB_APP_PASSWORD=
# generated: publish password for the local video server
SD_GROUND__VIDEO_PUBLISH_PASSWORD=
# generated: password for the local video server's control API (health, recordings)
SD_GROUND__VIDEO_API_PASSWORD=
# generated: API key between the AI commander and the local model server
SD_LLM_API_KEY=

# optional: key for the cloud model (OpenAI-compatible API, default OpenRouter).
# Leave empty to run with the local model only.
SD_CLOUD_API_KEY=
# optional: key for the Jev decision engine (TypeSafe AI), used by the quick stop check
SD_JEV_API_KEY=
# optional: key for the OpenAI Decisions API, used by the quick stop check
SD_OPENAI_API_KEY=

# filled by `just setup-config`: user and group id for container file ownership
SD_UID=
SD_GID=
# filled by `just setup-config`: mission data outside the repository
SD_DATA_DIR=
