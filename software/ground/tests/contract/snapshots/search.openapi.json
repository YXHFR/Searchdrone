{
  "components": {
    "schemas": {
      "ColorName": {
        "enum": [
          "black",
          "white",
          "gray",
          "red",
          "orange",
          "yellow",
          "green",
          "blue",
          "purple",
          "pink",
          "brown",
          "beige",
          "unknown"
        ],
        "title": "ColorName",
        "type": "string"
      },
      "Garment": {
        "additionalProperties": false,
        "properties": {
          "certainty": {
            "enum": [
              "certain",
              "likely",
              "unsure"
            ],
            "title": "Certainty",
            "type": "string"
          },
          "colors": {
            "items": {
              "$ref": "#/components/schemas/ColorName"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Colors",
            "type": "array"
          },
          "kind": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "part": {
            "enum": [
              "outer",
              "upper",
              "lower",
              "headwear",
              "footwear",
              "full_body"
            ],
            "title": "Part",
            "type": "string"
          },
          "pattern": {
            "anyOf": [
              {
                "enum": [
                  "solid",
                  "striped",
                  "checked",
                  "patterned",
                  "reflective"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pattern"
          },
          "shade": {
            "anyOf": [
              {
                "enum": [
                  "light",
                  "dark"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shade"
          },
          "source": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "required": [
          "part",
          "colors",
          "certainty"
        ],
        "title": "Garment",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Hair": {
        "additionalProperties": false,
        "properties": {
          "certainty": {
            "enum": [
              "certain",
              "likely",
              "unsure"
            ],
            "title": "Certainty",
            "type": "string"
          },
          "color": {
            "$ref": "#/components/schemas/ColorName"
          },
          "length": {
            "enum": [
              "short",
              "long",
              "bald",
              "unknown"
            ],
            "title": "Length",
            "type": "string"
          }
        },
        "required": [
          "color",
          "length",
          "certainty"
        ],
        "title": "Hair",
        "type": "object"
      },
      "Item": {
        "additionalProperties": false,
        "properties": {
          "certainty": {
            "enum": [
              "certain",
              "likely",
              "unsure"
            ],
            "title": "Certainty",
            "type": "string"
          },
          "colors": {
            "items": {
              "$ref": "#/components/schemas/ColorName"
            },
            "maxItems": 3,
            "title": "Colors",
            "type": "array"
          },
          "kind": {
            "enum": [
              "backpack",
              "bag",
              "cane",
              "walker",
              "umbrella",
              "bicycle",
              "dog",
              "other"
            ],
            "title": "Kind",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "kind",
          "certainty"
        ],
        "title": "Item",
        "type": "object"
      },
      "LastSeen": {
        "additionalProperties": false,
        "description": "The initial planning point (IPP): where and when the person was last seen.",
        "properties": {
          "at_utc": {
            "format": "date-time",
            "title": "At Utc",
            "type": "string"
          },
          "heading_deg": {
            "anyOf": [
              {
                "exclusiveMaximum": 360.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading Deg"
          },
          "kind": {
            "default": "point_last_seen",
            "enum": [
              "point_last_seen",
              "last_known_position"
            ],
            "title": "Kind",
            "type": "string"
          },
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon",
            "type": "number"
          },
          "source": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "required": [
          "lat",
          "lon",
          "at_utc"
        ],
        "title": "LastSeen",
        "type": "object"
      },
      "SearchProfile": {
        "additionalProperties": false,
        "description": "What the person looked like, as the operator approved it.\n\nA proposal from the AI has ``approved_by = None`` and is never used for matching.",
        "properties": {
          "age_band": {
            "anyOf": [
              {
                "enum": [
                  "child",
                  "youth",
                  "adult",
                  "senior"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Band"
          },
          "approved_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved At"
          },
          "approved_by": {
            "anyOf": [
              {
                "pattern": "^operator:[a-z0-9][a-z0-9_-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved By"
          },
          "excluded": {
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "title": "Excluded",
            "type": "array"
          },
          "free_text": {
            "default": "",
            "maxLength": 2000,
            "title": "Free Text",
            "type": "string"
          },
          "garments": {
            "items": {
              "$ref": "#/components/schemas/Garment"
            },
            "maxItems": 8,
            "title": "Garments",
            "type": "array"
          },
          "hair": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Hair"
              },
              {
                "type": "null"
              }
            ]
          },
          "height_band": {
            "anyOf": [
              {
                "enum": [
                  "short",
                  "medium",
                  "tall"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height Band"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "maxItems": 6,
            "title": "Items",
            "type": "array"
          },
          "last_seen": {
            "$ref": "#/components/schemas/LastSeen"
          },
          "likely_state": {
            "items": {
              "enum": [
                "walking",
                "sitting",
                "lying",
                "unknown"
              ],
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Likely State",
            "type": "array"
          },
          "mission_id": {
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
            "title": "Mission Id",
            "type": "string"
          },
          "mobility": {
            "default": "unknown",
            "enum": [
              "good",
              "reduced",
              "unknown"
            ],
            "title": "Mobility",
            "type": "string"
          },
          "profile_id": {
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
            "title": "Profile Id",
            "type": "string"
          },
          "profile_version": {
            "minimum": 1.0,
            "title": "Profile Version",
            "type": "integer"
          },
          "subject_category": {
            "enum": [
              "dementia",
              "hiker",
              "despondent",
              "gatherer",
              "hunter",
              "child_1_6",
              "child_7_12",
              "child_13_15",
              "autism",
              "other"
            ],
            "title": "Subject Category",
            "type": "string"
          },
          "visual_notes": {
            "default": "",
            "maxLength": 300,
            "title": "Visual Notes",
            "type": "string"
          }
        },
        "required": [
          "subject_category",
          "last_seen",
          "profile_id",
          "profile_version",
          "mission_id"
        ],
        "title": "SearchProfile",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Searchdrone search API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/search/v1/health": {
      "get": {
        "description": "The search service's view of the ground station: up, and whether the database is.",
        "operationId": "health_search_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Search V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/search/v1/missions/{mission_id}/search-profile": {
      "get": {
        "description": "The approved version in force, or ``null``: a proposal from the AI is never\nreturned here, so the matching cannot use one (E10).",
        "operationId": "get_search_profile_search_v1_missions__mission_id__search_profile_get",
        "parameters": [
          {
            "in": "path",
            "name": "mission_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "title": "Mission Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/SearchProfile"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Get Search Profile Search V1 Missions  Mission Id  Search Profile Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Search Profile"
      }
    }
  }
}
