{
  "name": "@searchdrone/panel",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Searchdrone web panel: chat, map, video, status and the always-visible STOP / RETURN HOME bar.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:test": "vite build --mode test --outDir dist-test",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:sitl": "playwright test -c playwright.sitl.config.ts",
    "e2e:perf": "playwright test -c playwright.perf.config.ts",
    "check": "node scripts/check-offline.mjs && node scripts/check-bundle-size.mjs && node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@searchdrone/schemas": "workspace:*",
    "i18next": "^26.4.6",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "^6.14.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.18",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
